{
  "name": "rematch-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Local daily remote job matching worker",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --env-file=.env.local dist/main.js",
    "once": "tsx --env-file=.env.local src/main.ts --once",
    "seed": "tsx --env-file=.env.local src/seed/remoteintech.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "croner": "^11.0.0",
    "entities": "^9.0.0",
    "fast-xml-parser": "^5.12.0",
    "nodemailer": "^10.3.1",
    "p-limit": "^7.3.3",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
