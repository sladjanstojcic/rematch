# Copy to worker/.env.local. npm start/once/seed load that file using Node/tsx.
# Obtain local values from supabase status -o env privately; never paste keys into logs.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Use DB_URL from the owned stack's status as DATABASE_URL.
DATABASE_URL=
ANTHROPIC_API_KEY=
OWNER_EMAIL=
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
# SMTP_USER and SMTP_PASS stay unset for local Mailpit.
MAIL_FROM="Rematch <digest@rematch.local>"
RUN_CRON="0 7 * * *"
# IANA timezone for RUN_CRON and the one-digest-per-day boundary, e.g. Europe/Berlin.
TZ=UTC
